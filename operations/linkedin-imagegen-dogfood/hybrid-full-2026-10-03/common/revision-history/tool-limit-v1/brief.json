  "style": {
    "brand": "Digiwin; reproduce official supplied brand mark once, stable header treatment; no invented glyphs",
    "palette": [
      "white",
      "#0052FF",
      "#0B132B",
      "#00B4D8",
      "charcoal"
    ],
    "lighting": "bright neutral daylight with soft grounded shadows",
    "avoid": [
      "neon",
      "dark mode",
      "human faces",
      "fabricated metrics identifiers dates statuses or results",
      "customer marks or facility evidence",
      "unreviewed capability or outcome claims",
      "reference wording record values props or exact composition",
      "printed caption native headline alt or internal notes",
      "extra wording beyond approved artwork text and official brand mark"
    ],
    "campaign": {
      "revision": "campaign-r2-hybrid-full-v1-parent-review-pending",
      "instructions": "Use the six R2 references as a coherent campaign visual grammar: bright white, soft blue and navy; neutral daylight; soft grounded shadows; photographic material depth and a credible shared material world. Strong blue/navy headline, readable secondary text and stable official logo/category/sequence treatment. Integrate relationship diagrams into the same physical scene, with matching light, material and depth; a flat standalone white infographic alone does not establish the chosen R2 family. Vary view angle, scene scale, negative space and scene/diagram balance according to each card reader question or action. Fabless Planning scenes should express product, plan and outsourced-lot relationships; Partner Architecture scenes should express ownership, handoff, reconciliation and responsibility. Semiconductor cues must suit the cohort; never require OSAT chip trays for Fabless or Partner. Maintain identity and hierarchy across both complete five-card carousels while each card adds a distinct meaning. Support opening orientation, comparison, context, responsibility/next step and closing as a flexible narrative, not a mandatory universal workflow. Keep closing/source content clearly separated and readable at ordinary desktop and 390px mobile viewing scale without zoom. Preserve reviewed Taiwan attribution and source scope; do not imply a facility or deployment. Transfer only reviewed colors, lighting, shadows, material depth, typography hierarchy, campaign identity and scene-integrated diagram language. Never copy reference words, record values, exact composition or a fixed prop list; no 12/38/50 layout requirement, mandatory paper/pen/tray, five-folder count or Taipei skyline. Print only exact approved artwork fields/labels and the official mark; caption/native headline/alt stay outside raster. Diagrams may use only reviewed labels, with no invented identifiers dates metrics statuses guarantees or outcomes. Do not add internal proof/review caveats or technical instructions as viewer wording. Actual images must be judged per card, full five-card narrative and across scenarios; unique prompts, IDs, hashes or prop counts cannot prove visual quality."
    }
  },
  "definitions": {
    "OSAT": "dịch vụ đóng gói và kiểm thử bán dẫn thuê ngoài",
    "Fabless": "thiết kế chip, không sở hữu nhà máy chế tạo",
    "WIP": "bán thành phẩm"
  },
