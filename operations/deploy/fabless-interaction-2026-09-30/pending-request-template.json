ivate(button) {\n        renderMap(button.dataset.mode, selected[button.dataset.mode], true);\n      }\n      buttons.forEach(function (button, index) {\n        button.addEventListener('click', function () { activate(button); });\n        button.addEventListener('keydown', function (event) {\n          var next = index;\n          if (event.key === 'ArrowRight') next = (index + 1) % buttons.length;\n          else if (event.key === 'ArrowLeft') next = (index - 1 + buttons.length) % buttons.length;\n          else if (event.key === 'Home') next = 0;\n          else if (event.key === 'End') next = buttons.length - 1;\n          else return;\n          event.preventDefault();\n          activate(buttons[next]);\n          buttons[next].focus({ preventScroll: true });\n        });\n      });\n    });\n    demoSelect.addEventListener('change', function () {\n      renderMap(currentMode, Number(demoSelect.value), true);\n    });\n    $$('.stage-card').forEach(function (card) {\n      card.addEventListener('click', function () {\n        renderMap('progress', Number(card.dataset.stage), true);\n      });\n    });\n    var btnFwd = $('#btn-trace-forward');\n    if (btnFwd) {\n      btnFwd.addEventListener('click', function () {\n        renderMap('lot', 0, true);\n      });\n    }\n    var btnRma = $('#btn-trace-rma');\n    if (btnRma) {\n      btnRma.addEventListener('click', function () {\n        renderMap('lot', 4, true);\n      });\n    }\n    var nodeScrap = $('#node-bin-7');\n    if (nodeScrap) {\n      nodeScrap.style.cursor = 'pointer';\n      nodeScrap.addEventListener('click', function () {\n        renderMap('lot', 4, true);\n      });\n    }\n    var nodeRoot = $('#node-wf-root');\n    if (nodeRoot) {\n      nodeRoot.addEventListener('click', function () {\n        renderMap('lot', 0, true);\n      });\n    }\n    var nodeAsm1 = $('#node-asm-01');\n    if (nodeAsm1) {\n      nodeAsm1.addEventListener('click', function () {\n        renderMap('lot', 1, true);\n