   badge: 'Hạch toán đa tầng tự động',\n        sla: 'Giá bán: $12.50',\n        eta: 'Giá vốn: $8.40',\n        yield: 'Biên gộp: 32.8%'\n      }\n    };\n\n    var costScenarios = {\n      ai: {\n        costs: ['$4.20 / chip <small>(50.0%)</small>', '$2.10 / chip <small>(25.0%)</small>', '$1.20 / chip <small>(14.3%)</small>', '$0.90 / chip <small>(10.7%)</small>'],\n        widths: ['50%', '25%', '14.3%', '10.7%'],\n        cogs: '$8.40',\n        cogsPct: 'Chiếm 67.2% giá bán',\n        margin: '+$4.10 <small>(32.8%)</small>',\n        price: '$12.50',\n        stackCost: '67.2%',\n        stackMargin: '32.8%',\n        status: '🟢 Đạt mục tiêu ban giám đốc (>30%)'\n      },\n      mcu: {\n        costs: ['$0.65 / chip <small>(54.2%)</small>', '$0.35 / chip <small>(29.2%)</small>', '$0.12 / chip <small>(10.0%)</small>', '$0.08 / chip <small>(6.6%)</small>'],\n        widths: ['54.2%', '29.2%', '10%', '6.6%'],\n        cogs: '$1.20',\n        cogsPct: 'Chiếm 64.9% giá bán',\n        margin: '+$0.65 <small>(35.1%)</small>',\n        price: '$1.85',\n        stackCost: '64.9%',\n        stackMargin: '35.1%',\n        status: '🟢 Biên an toàn cao nhờ tối ưu chi phí phôi'\n      }\n    };\n\n\n    function pulse(element) {\n      if (!element) return;\n      clearTimeout(pulseTimers.get(element));\n      element.classList.remove('pulse');\n      if (reduceMotion() || document.hidden) return;\n      requestAnimationFrame(function () { if (!reduceMotion() && !document.hidden) element.classList.add('pulse'); });\n      pulseTimers.set(element, setTimeout(function () { element.classList.remove('pulse'); }, 2000));\n    }\n    function setTabs(group, mode) {\n      $$('[data-tab-group=\"' + group + '\"] [role=\"tab\"]').forEach(function (tab) {\n        var active = tab.dataset.mode === mode;\n        tab.setAttribute('aria-selected', String(active));\n        tab.tabIndex = active ? 0 : -1;\n      });\n      var panel = $('#' + group + '-panel');\n      if (panel) panel.setAttribute('aria-labelledby', group + '-tab-' + mode);\n    }\n    function updateCostScenario(key) {\n      var sc = costScenarios[key] || costScenarios.ai;\n      var btnAi = $('#btn-cost-ai');\n      var btnMcu = $('#btn-cost-mcu');\n      if (btnAi) btnAi.classList.toggle('is-active', key === 'ai');\n      if (btnMcu) btnMcu.classList.toggle('is-active', key === 'mcu');\n      sc.costs.forEach(function (c, idx) {\n        var el = $('#tier-cost-' + (idx + 1));\n        if (el) el.innerHTML = c;\n        var bar = $('#tier-bar-' + (idx + 1));\n        if (bar) bar.style.width = sc.widths[idx];\n      });\n      var cogsEl = $('#ledger-cogs');\n      if (cogsEl) cogsEl.textContent = sc.cogs;\n      var cogsPctEl = $('#ledger-cogs-pct');\n      if (cogsPctEl) cogsPctEl.textContent = sc.cogsPct;\n      var marginEl = $('#ledger-margin');\n      if (marginEl) marginEl.innerHTML = sc.margin;\n      var priceEl = $('#ledger-price');\n      if (priceEl) priceEl.textContent = sc.price;\n      var stackCost = $('#stack-cost-bar');\n      if (stackCost) {\n        stackCost.style.width = sc.stackCost;\n        stackCost.title = 'Giá vốn ' + sc.stackCost;\n        stackCost.innerHTML = '<span>Giá vốn ' + sc.cogs + '</span>';\n      }\n      var stackMargin = $('#stack-margin-bar');\n      if (stackMargin) {\n        stackMargin.style.width = sc.stackMargin;\n        stackMargin.title = 'Biên lợi nhuận ' + sc.stackMargin;\n        stackMargin.innerHTML = '<span>Lợi nhuận gộp ' + sc.stackMargin + '</span>';\n      }\n      var statusEl = $('#ledger-status');\n      if (statusEl) statusEl.textContent = sc.status;\n    }\n\n    function renderMap(mode, index, animate) {\n      if (!Object.prototype.hasOwnProperty.call(demoData, mode)) return;\n      var data = demoData[mode];\n      index = Number.isInteger(index) && index >= 0 && index < data.options.length ? index : 0;\n      var changedMode = currentMode !== mode;\n      currentMode = mode;\n      selected[mode] = index;\n  